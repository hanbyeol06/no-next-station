{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack.schema.json",
  "title": "다음 역은 없습니다 · 콘텐츠 팩",
  "type": "object",
  "required": [
    "packId", "schemaVersion", "localeId", "routeId", "stationId", "episodeId",
    "shift", "evidence", "incidents", "effects", "profiles", "expectedPathDistribution"
  ],
  "properties": {
    "packId": { "type": "string", "pattern": "^PACK-[A-Z0-9-]+$" },
    "schemaVersion": { "const": 1 },
    "localeId": { "type": "string", "minLength": 1 },
    "routeId": { "type": "string", "pattern": "^ROUTE-[A-Z0-9-]+$" },
    "stationId": { "type": "string", "pattern": "^STATION-[A-Z0-9-]+$" },
    "episodeId": { "type": "string", "pattern": "^EP-[A-Z0-9-]+$" },
    "titleKey": { "type": "string", "minLength": 1 },
    "shift": {
      "type": "object",
      "required": [
        "shiftId", "titleKey", "introKey", "rulesIntroKey", "endNoteKey", "incidentIds",
        "profileId", "startingRecordTrust", "startingEcho"
      ],
      "properties": {
        "shiftId": { "type": "string", "pattern": "^SHIFT-[A-Z0-9-]+$" },
        "titleKey": { "type": "string", "minLength": 1 },
        "introKey": { "type": "string", "minLength": 1 },
        "rulesIntroKey": { "type": "string", "minLength": 1 },
        "endNoteKey": { "type": "string", "minLength": 1 },
        "incidentIds": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": { "type": "string", "pattern": "^CALL-[A-Z0-9-]+$" }
        },
        "profileId": { "type": "string", "pattern": "^PROFILE-[A-Z0-9-]+$" },
        "startingRecordTrust": { "const": 0 },
        "startingEcho": { "const": 0 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidenceId", "incidentId", "schemaVersion", "sourceId", "sourceKey", "observedAt",
          "displayedStateKey", "viewId", "preAccessible", "titleKey", "contentKey"
        ],
        "properties": {
          "evidenceId": { "type": "string", "pattern": "^EVID-[A-Z0-9-]+$" },
          "incidentId": { "type": "string", "pattern": "^CALL-[A-Z0-9-]+$" },
          "schemaVersion": { "const": 1 },
          "sourceId": { "type": "string", "minLength": 1 },
          "sourceKey": { "type": "string", "minLength": 1 },
          "observedAt": { "type": "string", "minLength": 1 },
          "displayedStateKey": { "type": "string", "minLength": 1 },
          "viewId": { "type": "string", "minLength": 1 },
          "feedId": { "type": "string" },
          "preAccessible": { "const": true },
          "titleKey": { "type": "string", "minLength": 1 },
          "contentKey": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "incidents": { "type": "array", "items": { "$ref": "incident.schema.json" } },
    "effects": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["effectId", "type", "targetId", "state", "persistence"],
            "properties": {
              "effectId": { "type": "string", "pattern": "^FX-[A-Z0-9-]+$" },
              "type": { "const": "set_scene_state" },
              "targetId": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "minLength": 1 },
              "persistence": { "enum": ["shift", "temporary"] },
              "resolution": { "$ref": "#/$defs/resolution" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "persistence": { "const": "temporary" } },
                  "required": ["persistence"]
                },
                "then": { "required": ["resolution"] }
              }
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["effectId", "type", "flagId"],
            "properties": {
              "effectId": { "type": "string", "pattern": "^FX-[A-Z0-9-]+$" },
              "type": { "enum": ["grant_flag", "consume_flag"] },
              "flagId": { "type": "string", "pattern": "^FLAG-[A-Z0-9-]+$" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["effectId", "type", "cueId"],
            "properties": {
              "effectId": { "type": "string", "pattern": "^FX-[A-Z0-9-]+$" },
              "type": { "const": "play_feedback" },
              "cueId": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "profileId", "schemaVersion", "perfectRunEndingId", "recordTrust", "echo", "endings"
        ],
        "properties": {
          "profileId": { "type": "string", "pattern": "^PROFILE-[A-Z0-9-]+$" },
          "schemaVersion": { "const": 1 },
          "perfectRunEndingId": { "type": "string", "pattern": "^END-[A-Z0-9-]+$" },
          "recordTrust": {
            "type": "object",
            "required": ["minimum", "maximum"],
            "properties": { "minimum": { "const": 0 }, "maximum": { "const": 5 } },
            "additionalProperties": false
          },
          "echo": {
            "type": "object",
            "required": ["minimum", "maximum", "cap"],
            "properties": {
              "minimum": { "const": 0 }, "maximum": { "const": 4 }, "cap": { "const": 4 }
            },
            "additionalProperties": false
          },
          "endings": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["endingId", "priority", "titleKey", "copyKey", "condition"],
              "properties": {
                "endingId": { "type": "string", "pattern": "^END-[A-Z0-9-]+$" },
                "priority": { "type": "integer" },
                "titleKey": { "type": "string", "minLength": 1 },
                "copyKey": { "type": "string", "minLength": 1 },
                "condition": { "$ref": "#/$defs/condition" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flagId"],
        "properties": { "flagId": { "type": "string", "pattern": "^FLAG-[A-Z0-9-]+$" } },
        "additionalProperties": false
      }
    },
    "expectedPathDistribution": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  },
  "$defs": {
    "resolution": {
      "type": "object",
      "required": ["beforeIncidentId", "storyTime", "state", "residue"],
      "properties": {
        "beforeIncidentId": { "type": "string", "pattern": "^CALL-[A-Z0-9-]+$" },
        "storyTime": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "state": { "type": "string", "minLength": 1 },
        "residue": {
          "type": "object",
          "required": ["targetId", "state"],
          "properties": {
            "targetId": { "type": "string", "minLength": 1 },
            "state": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["always"],
          "properties": { "always": { "const": true } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["anyOf"],
          "properties": {
            "anyOf": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["allOf"],
          "properties": {
            "allOf": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["metric", "operator", "value"],
          "properties": {
            "metric": { "enum": ["recordTrust", "echo"] },
            "operator": { "enum": ["eq", "lte", "gte", "lt", "gt"] },
            "value": { "type": "number" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
